{
  "name": "@daisy/desktop",
  "productName": "Daisy",
  "version": "0.1.0",
  "private": true,
  "description": "Daisy: a visual editor for real HTML and CSS websites.",
  "author": {
    "name": "Daisy contributors"
  },
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "package": "pnpm --filter @daisy/native build && electron-vite build && electron-builder --config electron-builder.yml --publish never",
    "release": "pnpm --filter @daisy/native build && electron-vite build && electron-builder --config electron-builder.yml --publish always",
    "clean": "node ../../scripts/clean.ts . release"
  },
  "dependencies": {
    "@daisy/di": "workspace:*",
    "@daisy/editor": "workspace:*",
    "@daisy/export": "workspace:*",
    "@daisy/ipc": "workspace:*",
    "@daisy/mcp-server": "workspace:*",
    "@daisy/model": "workspace:*",
    "@daisy/native": "workspace:*",
    "@daisy/project-fs": "workspace:*",
    "@daisy/ui": "workspace:*",
    "electron-updater": "^6.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.0.0"
  }
}
